extends "res://core/fighter/fighter_controller.gd"


func _get_input_mapping() -> Dictionary:
	return {
		InputBits.MOVE_LEFT: &"p2_left",
		InputBits.MOVE_RIGHT: &"p2_right",
		InputBits.JUMP: &"p2_jump",
		InputBits.CROUCH: &"p2_crouch",
	}


func _get_initial_facing() -> int:
	return FacingController.LEFT
