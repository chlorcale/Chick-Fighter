extends "res://core/fighter/fighter_controller.gd"


func _get_input_mapping() -> Dictionary:
	return {
		InputBits.MOVE_LEFT: &"p1_left",
		InputBits.MOVE_RIGHT: &"p1_right",
		InputBits.JUMP: &"p1_jump",
		InputBits.CROUCH: &"p1_crouch",
	}


func _get_initial_facing() -> int:
	return FacingController.RIGHT
